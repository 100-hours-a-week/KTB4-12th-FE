# 실제 API 서버를 연결할 때 false로 변경합니다.
VITE_USE_MOCK_API=true

# 예: https://api.example.com
VITE_API_BASE_URL=

# Sentry React SDK (클라이언트 DSN은 공개 식별자이며 브라우저 번들에 포함됩니다.)
VITE_SENTRY_DSN=

# 버그 제보 위젯용 Discord 웹훅 (개발 전용 — 번들에 노출되므로 프로덕션에서는 백엔드 프록시로 교체)
# VITE_DISCORD_WEBHOOK_URL=

# 백엔드 프록시 사용 시 (설정하면 웹훅 URL보다 우선). VITE_API_BASE_URL을 앞에 붙여서 호출한다.
VITE_BUG_REPORT_ENDPOINT=/bug-report
