# 실제 API 서버를 연결할 때 false로 변경합니다.
VITE_USE_MOCK_API=true

# 예: https://api.example.com
VITE_API_BASE_URL=

# Sentry React SDK (클라이언트 DSN은 공개 식별자이며 브라우저 번들에 포함됩니다.)
# 운영 빌드: GitHub Actions 저장소 변수 VITE_SENTRY_DSN을 Docker 빌드 인자로 전달합니다.
VITE_SENTRY_ENABLED=false
VITE_SENTRY_DSN=

# 버그 제보 백엔드 엔드포인트. VITE_API_BASE_URL을 앞에 붙여서 호출한다.
VITE_BUG_REPORT_ENDPOINT=/bug-report
